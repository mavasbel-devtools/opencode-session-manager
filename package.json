{
  "name": "opencode-db-compact",
  "version": "0.2.0",
  "private": true,
  "description": "Offline, verified compaction of an OpenCode 2 opencode.db, with a rename-swap backup and rollback (strict hexagonal, Node 24 + TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "imports": {
    "#domain/*": "./src/domain/*",
    "#application/*": "./src/application/*",
    "#infrastructure/*": "./src/infrastructure/*",
    "#main/*": "./src/main/*",
    "#test/*": "./tests/*"
  },
  "scripts": {
    "cli": "node src/main/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:component && npm run test:e2e && npm run test:live",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:component": "node scripts/run-tests.mjs component",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:live": "node scripts/run-tests.mjs live",
    "coverage": "npm run coverage:unit && npm run coverage:e2e",
    "coverage:unit": "node scripts/coverage.mjs unit",
    "coverage:e2e": "node scripts/coverage.mjs e2e",
    "lint:diagrams": "node scripts/lint-diagrams.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
